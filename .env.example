NODE_ENV=develop
PORT=3000

CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345678
DB_NAME=nestjs
DB_POOL_MAX=60
DB_POOL_MIN=5
DB_POOL_ACQUIRE_TIMEOUT=3000
DB_POOL_IDLE_TIMEOUT=30000

# JWT
JWT_SECRET=

# Super admin inicial
SUPER_ADMIN_EMAIL=myemail
SUPER_ADMIN_PASSWORD=mypass
SUPER_ADMIN_USERNAME=myuser

# Cloudinary (obligatorio para subir imágenes y crear productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ORPHAN_UPLOADS_CLEANUP_CRON=*/15 * * * *
ORPHAN_UPLOADS_MIN_AGE_MINUTES=30

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=12345678

# Idempotencia
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_SECONDS=60
WEBHOOK_EVENT_TTL_SECONDS=604800

# Stripe (pega tus claves reales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Pedidos
ORDER_PAYMENT_TTL_MINUTES=30
PENDING_ORDERS_EXPIRATION_CRON=*/5 * * * *

# Circuit breaker
CB_TIMEOUT_MS=8000
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT_MS=15000
CB_VOLUME_THRESHOLD=5